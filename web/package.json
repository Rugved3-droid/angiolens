{
  "name": "coronary-projection-trainer",
  "private": true,
  "version": "1.1.0-dev",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "start": "vite preview --port 5178 --strictPort --open /atlas.html",
    "launch": "npm run build && npm run start",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "launch:v1": "node scripts/launch_v1.mjs",
    "verify": "node scripts/verify_all.mjs"
  },
  "dependencies": {
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.3",
    "@types/three": "^0.186.0",
    "playwright": "^1.63.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.1",
    "vitest": "^5.0.3"
  }
}
